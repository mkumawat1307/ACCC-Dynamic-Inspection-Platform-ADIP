{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "team": {
      "model": "openrouter/google/gemini-3.1-flash-lite-preview",
      "options": {},
      "permission": {}
    }
  },
  "mcp": {
    "web-search": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": false,
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "sc:code-review": "allow",
      "sc:webapp-testing": "allow",
      "sc:mcp-builder": "allow",
      "ui-ux-pro-max": "allow",
      "ckm:design-system": "allow",
      "sc:design-sync": "allow",
      "ckm:ui-styling": "allow",
      "hebrew-rtl-best-practices": "allow",
      "hebrew-i18n": "allow",
      "hebrew-tailwind-preset": "allow",
      "hebrew-document-generator": "allow",
      "israeli-accessibility-compliance": "allow",
      "sc:codebase-index": "allow",
      "skill-installer": "allow",
      "team-builder": "allow"
    }
  }
}
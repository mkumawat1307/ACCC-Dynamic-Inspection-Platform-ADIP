{
  "expo": {
    "name": "ACCC Dynamic Inspection Platform",
    "slug": "frontend",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/abhay-logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.accc.dynamicinspection",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Capture GPS coordinates of the site",
        "NSCameraUsageDescription": "Take photos of the site and equipment",
        "NSPhotoLibraryUsageDescription": "Attach existing photos to the inspection",
        "NSPhotoLibraryAddUsageDescription": "Save inspection Excel files to your device"
      }
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/abhay-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.accc.dynamicinspection",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/abhay-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/abhay-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Capture GPS coordinates of the site"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos of the site and equipment"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ACCC Dynamic Inspection Platform to access attached photos",
          "savePhotosPermission": "Allow ACCC Dynamic Inspection Platform to save attached photos to your gallery",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9544105a-8025-47f2-b114-80f17c85057d"
      }
    }
  }
}

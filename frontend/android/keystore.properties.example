# Template for release signing credentials.
# Copy this file to keystore.properties (same directory) and replace the
# placeholders with your production keystore details.
#
# keystore.properties and keystore files (*.jks / *.keystore) are gitignored
# and excluded from the EAS archive (.easignore) - real credentials must never
# be committed. Each value is validated at release build time; a missing,
# incomplete, or debug.keystore-pointing config fails the release build with a
# clear error instead of silently signing with the debug key.
storeFile=app/release.keystore
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD